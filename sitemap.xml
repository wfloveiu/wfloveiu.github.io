---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
{% for post in site.personal_posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
{% for page in site.html_pages %}{% unless page.url == '/404.html' or page.redirect_to %}<url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>{% endunless %}{% endfor %}
</urlset>
